# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit real secrets.

# Telegram user ID of the only person allowed to command the bot.
OWNER_TELEGRAM_ID=

# Telegram bot token from @BotFather (do not commit).
TELEGRAM_BOT_TOKEN=

# Capkey vault contract (testnet).
VAULT_CONTRACT_ID=vault2.wavecapkey.testnet

# NEAR account the bot signs with (holds only a locked function call key).
AGENT_ACCOUNT_ID=dave-agent2.testnet

# Owner account of the vault (testnet)
OWNER_ACCOUNT_ID=dave-owner.testnet
